BAIDU_OCR_MERGE_TABLES=true
BAIDU_OCR_RELEVEL_TITLES=true
BAIDU_OCR_RETURN_SPAN_BOXES=true
BAIDU_OCR_ANALYSIS_CHART=false
BAIDU_OCR_RECOGNIZE_SEAL=false
